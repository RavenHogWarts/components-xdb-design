{
  "source": "file",
  "fields": [
    { "name": "xdbType", "type": "text" },
    { "name": "file.basename" },
    {
      "name": "status",
      "type": "select",
      "options": {
        "items": [
          { "value": "planned", "color": "gray" },
          { "value": "active", "color": "blue" },
          { "value": "blocked", "color": "red" },
          { "value": "done", "color": "green" }
        ]
      }
    },
    {
      "name": "priority",
      "type": "select",
      "options": {
        "items": [
          { "value": "low", "color": "gray" },
          { "value": "medium", "color": "yellow" },
          { "value": "high", "color": "red" }
        ]
      }
    },
    { "name": "owner", "type": "text" },
    { "name": "deadline", "type": "date", "options": { "format": "YYYY-MM-DD" } },
    {
      "name": "归档",
      "type": "button",
      "options": {
        "icon": "archive",
        "actions": [
          { "id": "archive-project", "type": "move-row", "targetFolder": "Archive/Projects" }
        ]
      }
    }
  ],
  "filter": {
    "id": "project-scope",
    "type": "group",
    "join": "and",
    "items": [
      {
        "id": "project-scope-expression",
        "type": "expression",
        "expression": "file.path.startsWith(\"Projects/\") && xdbType == \"project\""
      }
    ]
  },
  "views": [
    {
      "id": "project-dashboard",
      "name": "项目总览",
      "type": "group",
      "icon": "layout-dashboard",
      "options": { "groupType": "dashboard", "locked": false }
    },
    {
      "id": "project-completion",
      "name": "完成率",
      "type": "metric",
      "parentId": "project-dashboard",
      "icon": "circle-check-big",
      "expression": "($items.length ? Math.round($items.filter((item) => item.status === 'done').length / $items.length * 100) : 0) + '%'",
      "layouts": {
        "laptop": { "x": 0, "y": 0, "w": 6, "h": 4 },
        "mobile": { "x": 0, "y": 0, "w": 4, "h": 4 }
      }
    },
    {
      "id": "project-overdue",
      "name": "逾期项目",
      "type": "table",
      "parentId": "project-dashboard",
      "visibleFields": ["file.basename", "status", "priority", "owner", "deadline", "归档"],
      "filter": {
        "id": "project-overdue-filter",
        "type": "group",
        "join": "and",
        "items": [
          {
            "id": "project-overdue-expression",
            "type": "expression",
            "expression": "!isEmpty(deadline) && deadline < today() && status != \"done\""
          }
        ]
      },
      "sort": [{ "field": "deadline", "direction": "asc" }],
      "layouts": {
        "laptop": { "x": 6, "y": 0, "w": 18, "h": 10 },
        "mobile": { "x": 0, "y": 4, "w": 4, "h": 10 }
      }
    },
    {
      "id": "project-kanban",
      "name": "状态看板",
      "type": "kanban",
      "parentId": "project-dashboard",
      "visibleFields": ["file.basename", "priority", "owner", "deadline", "归档"],
      "group": {
        "by": [
          {
            "field": "status",
            "sort": ["planned", "active", "blocked", "done"],
            "pinned": ["planned", "active", "blocked", "done"]
          }
        ],
        "summary": "$items.length"
      },
      "layouts": {
        "laptop": { "x": 0, "y": 10, "w": 24, "h": 16 },
        "mobile": { "x": 0, "y": 14, "w": 4, "h": 16 }
      }
    },
    {
      "id": "project-calendar",
      "name": "截止日历",
      "type": "calendar",
      "parentId": "project-dashboard",
      "visibleFields": ["file.basename", "status", "priority", "owner"],
      "options": { "viewType": "month", "weekStartsOn": "monday", "startField": "deadline" },
      "layouts": {
        "laptop": { "x": 0, "y": 26, "w": 12, "h": 16 },
        "mobile": { "x": 0, "y": 30, "w": 4, "h": 16 }
      }
    },
    {
      "id": "project-table",
      "name": "项目明细",
      "type": "table",
      "parentId": "project-dashboard",
      "visibleFields": ["file.basename", "status", "priority", "owner", "deadline", "归档"],
      "sort": [
        { "field": "status", "direction": "asc" },
        { "field": "deadline", "direction": "asc" }
      ],
      "newRowAction": {
        "type": "create-file",
        "filePath": "Projects/{{date:YYYY-MM-DD}}-{{time:HHmmss}}-project.md",
        "template": "Templates/Project.md",
        "openMode": "tab"
      },
      "layouts": {
        "laptop": { "x": 12, "y": 26, "w": 12, "h": 16 },
        "mobile": { "x": 0, "y": 46, "w": 4, "h": 16 }
      }
    }
  ]
}
